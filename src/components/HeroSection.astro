---
import { SITE_CONFIG } from '../utils/siteConfig';

interface Props {
  image: string;
  imageSp?: string;
  alt?: string;
  phoneDisplay?: string;
  phoneHref?: string;
}

const {
  image,
  imageSp,
  alt = '設備プロの職人',
  phoneDisplay = SITE_CONFIG.phone.display,
  phoneHref = SITE_CONFIG.phone.href,
} = Astro.props;

const BADGES = [
  { label: '見積り0円', color: 'var(--color-water)' },
  { label: '最短10分で到着', color: 'var(--color-electric-deep)' },
  { label: '相談無料', color: 'var(--color-cta)' },
  { label: '24時間365日', color: 'var(--color-navy)' },
];
---

<section class="pt-8 pb-2 md:pt-12 md:pb-3" aria-label="メインビジュアル">
  <div class="max-w-[1120px] mx-auto px-5">
    <div class="grid grid-cols-1 md:grid-cols-[1.05fr_.95fr] gap-7 md:gap-12 items-center">
      <!-- Text column -->
      <div class="md:order-1 order-2">
        <span class="inline-flex items-center gap-2.5 text-[13px] font-bold tracking-[0.08em] text-water before:content-[''] before:w-7 before:h-[3px] before:rounded-sm before:bg-water">
          電気・水道の修理プロ
        </span>
        <h2 class="text-[27px] md:text-[40px] leading-[1.5] md:leading-[1.45] font-black text-navy mt-3.5 mb-3 overflow-wrap-anywhere">
          水まわり・電気のトラブル、<br class="hidden md:block" />
          <span class="text-water">最短10分</span>でプロが駆けつけます。
        </h2>
        <p class="text-[15px] md:text-base text-text-secondary leading-[1.9] mb-6 overflow-wrap-anywhere">
          トイレのつまり、水漏れ、ブレーカー、給湯器まで。設備プロの有資格の職人が、年中無休・24時間スピード対応。まずはお気軽にご相談ください。
        </p>

        <ul class="grid grid-cols-2 gap-2.5 mb-6 md:flex md:flex-wrap">
          {BADGES.map((b) => (
            <li class="flex items-center justify-center gap-2 bg-white border border-border-warm rounded-full px-2.5 py-2 text-[13px] font-bold text-navy shadow-[0_6px_24px_rgba(27,42,74,0.08)] md:px-4">
              <span class="w-2 h-2 rounded-full shrink-0" style={`background:${b.color}`} />
              {b.label}
            </li>
          ))}
        </ul>

        <div class="flex flex-col sm:flex-row sm:flex-wrap gap-3 sm:gap-3.5 items-stretch">
          <a
            href={phoneHref}
            class="bg-cta hover:bg-cta-deep transition-colors text-white rounded-2xl px-6 py-3.5 w-full sm:w-auto sm:flex-none text-center sm:text-left shadow-[0_8px_20px_rgba(255,107,0,0.28)]"
          >
            <span class="block text-[11px] font-medium opacity-95">お電話でのご相談（通話無料）</span>
            <span class="block text-[26px] font-black leading-tight tracking-wide whitespace-nowrap">{phoneDisplay}</span>
          </a>
          <a
            href="/contact"
            class="flex items-center justify-center gap-2 bg-white border-2 border-navy text-navy font-bold rounded-2xl px-6 py-3.5 sm:py-3 w-full sm:w-auto text-[15px] md:text-[19px] hover:bg-navy hover:text-white transition-colors"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-[22px] h-[22px] md:w-[30px] md:h-[30px] shrink-0" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path d="m3 7.5 8.4 5.6a1 1 0 0 0 1.2 0L21 7.5" />
            </svg>
            メールで無料相談
          </a>
        </div>
      </div>

      <!-- Media column -->
      <div class="relative md:order-2 order-1">
        <picture>
          {imageSp && <source media="(max-width: 767px)" srcset={imageSp} />}
          <img
            src={image}
            alt={alt}
            width="900"
            height="840"
            fetchpriority="high"
            loading="eager"
            decoding="async"
            class="w-full h-[240px] md:h-[420px] object-cover rounded-3xl shadow-[0_6px_24px_rgba(27,42,74,0.08)]"
          />
        </picture>
        <div class="absolute -left-2 md:-left-3.5 bottom-5 md:bottom-6 bg-white rounded-2xl px-4 py-3 md:px-[18px] md:py-3 shadow-[0_6px_24px_rgba(27,42,74,0.12)] border-l-[5px] border-water">
          <b class="block text-navy font-black text-base md:text-[18px] leading-tight">満足保証</b>
          <small class="text-text-secondary text-[11px] md:text-[12px]">ご納得いただけなければ料金0円</small>
        </div>
      </div>
    </div>

    <!-- Category selector -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-[18px] mt-7 md:mt-9">
      <a
        href="#water"
        class="flex items-center gap-4 bg-white border border-border-warm rounded-2xl px-5 py-4 md:px-[22px] md:py-[18px] shadow-[0_6px_24px_rgba(27,42,74,0.08)] hover:-translate-y-0.5 transition-transform"
      >
        <span class="w-12 h-12 md:w-[52px] md:h-[52px] rounded-2xl bg-water-tint flex items-center justify-center text-2xl shrink-0" aria-hidden="true">💧</span>
        <span class="min-w-0">
          <b class="block text-navy font-black text-base md:text-[18px]">水まわりの修理</b>
          <span class="text-[13px] text-text-secondary">トイレ・キッチン・お風呂・洗面所</span>
        </span>
        <span class="ml-auto font-black text-water" aria-hidden="true">→</span>
      </a>
      <a
        href="#electricity"
        class="flex items-center gap-4 bg-white border border-border-warm rounded-2xl px-5 py-4 md:px-[22px] md:py-[18px] shadow-[0_6px_24px_rgba(27,42,74,0.08)] hover:-translate-y-0.5 transition-transform"
      >
        <span class="w-12 h-12 md:w-[52px] md:h-[52px] rounded-2xl bg-electric-tint flex items-center justify-center text-2xl shrink-0" aria-hidden="true">⚡</span>
        <span class="min-w-0">
          <b class="block text-navy font-black text-base md:text-[18px]">電気まわりの修理</b>
          <span class="text-[13px] text-text-secondary">ブレーカー・コンセント・照明・給湯器</span>
        </span>
        <span class="ml-auto font-black text-electric-deep" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
