---
interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  items: FAQItem[];
}

const { items } = Astro.props;
---

<div class="mx-auto mt-2 max-w-3xl">
  {items.map((item) => (
    <details class="group border-b border-dotted border-line py-5">
      <summary class="flex min-h-11 cursor-pointer list-none items-start gap-3 [&::-webkit-details-marker]:hidden">
        <span class="flex min-h-11 min-w-11 items-center justify-center rounded-full bg-brand font-bold text-white" aria-hidden="true">Q</span>
        <span class="grow pt-2 font-bold text-ink">{item.question}</span>
        <span class="relative mt-3 h-5 w-5 shrink-0" aria-hidden="true">
          <span class="absolute left-1/2 top-1/2 h-0.5 w-full -translate-x-1/2 -translate-y-1/2 bg-brand" />
          <span class="absolute left-1/2 top-1/2 h-0.5 w-full -translate-x-1/2 -translate-y-1/2 rotate-90 bg-brand transition-transform group-open:rotate-180" />
        </span>
      </summary>
      <div class="flex items-start gap-3 pb-2 pt-4">
        <span class="flex min-h-11 min-w-11 items-center justify-center font-bold text-brand" aria-hidden="true">A</span>
        <p class="grow pt-2 leading-7 text-ink-soft">{item.answer}</p>
      </div>
    </details>
  ))}
</div>
