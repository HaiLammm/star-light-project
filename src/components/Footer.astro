---
import { SITE_CONFIG } from '@config/site';
---

<footer class="border-t border-line bg-paper-warm">
  <div class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-8 text-sm text-ink-soft md:px-6">
    <div class="flex items-center gap-3">
      <img src={SITE_CONFIG.logoPath} alt="" width="120" height="30" class="h-8 w-auto" loading="lazy" />
      <span class="font-bold text-ink">{SITE_CONFIG.siteName}</span>
    </div>
    <p>© {SITE_CONFIG.siteName}</p>
  </div>
</footer>
