---
import { SITE_CONFIG } from '@config/site';
import { FOOTER_NAV } from '@config/navigation';
import { COMPLIANCE } from '@config/compliance';
---

<footer class="border-t border-line bg-paper-warm">
  <div class="mx-auto flex max-w-6xl flex-col gap-8 px-4 py-10 text-sm text-ink-soft md:px-6">
    <div class="grid gap-8 sm:grid-cols-2 md:grid-cols-4">
      {FOOTER_NAV.map((section) => (
        <section>
          <h2 class="text-sm font-bold text-ink">{section.label}</h2>
          <ul class="mt-3 space-y-2">
            {section.children.map((item) => {
              const href = item.socialKey ? SITE_CONFIG.socialLinks[item.socialKey] : item.href;
              if (!href) return null;
              return <li><a href={href} class="inline-flex min-h-11 min-w-11 items-center justify-center rounded px-2 text-ink-soft underline-offset-2 hover:text-brand hover:underline focus-visible:outline-2 focus-visible:outline-brand">{item.label}</a></li>;
            })}
            {section.label === '公式チャンネル' && SITE_CONFIG.rssPath && <li><a href={SITE_CONFIG.rssPath} class="inline-flex min-h-11 min-w-11 items-center justify-center rounded px-2 text-ink-soft underline-offset-2 hover:text-brand hover:underline focus-visible:outline-2 focus-visible:outline-brand">RSS</a></li>}
          </ul>
        </section>
      ))}
    </div>
    <div class="flex flex-col gap-3 border-t border-line pt-6 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-center gap-3">
      <img src={SITE_CONFIG.logoPath} alt="" width="120" height="30" class="h-8 w-auto" loading="lazy" />
      <span class="font-bold text-ink">{SITE_CONFIG.siteName}</span>
      </div>
      <p>© {SITE_CONFIG.siteName}</p>
    </div>
    <p class="text-xs leading-6 text-notice">{COMPLIANCE.notices.footer} <a href={COMPLIANCE.disclosureLinks.responsibleGambling} class="inline-flex min-h-11 items-center underline underline-offset-2 focus-visible:outline-2 focus-visible:outline-brand">責任あるギャンブル</a></p>
  </div>
</footer>
