---
import type { RegionalOffice } from '@config/site';
import { officeMapEmbedUrl, officeMapUrl } from '../utils/maps';

interface Props {
  office: RegionalOffice;
}

const { office } = Astro.props;
const embedUrl = officeMapEmbedUrl(office);
const mapUrl = officeMapUrl(office);
---

{embedUrl && (
  <div class="mt-5 md:mt-6">
    <!-- aspect-ratio giữ chỗ trước khi iframe tải để không gây CLS; lazy vì nằm dưới fold -->
    <iframe
      src={embedUrl}
      title={`${office.name}の地図`}
      class="block w-full aspect-[4/3] md:aspect-[16/10] rounded-xl border-0 bg-[#eef1f4]"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      allowfullscreen
    ></iframe>
  </div>
)}
{mapUrl && (
  <a
    href={mapUrl}
    target="_blank"
    rel="noopener"
    class="mt-3 inline-flex items-center gap-1 min-h-[44px] text-[14px] md:text-[15px] font-bold text-water hover:underline"
  >
    Googleマップで見る
    <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h6v6"/><path d="M20 4 10 14"/><path d="M19 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5"/></svg>
    <span class="sr-only">（新しいタブで開きます）</span>
  </a>
)}
