---
import { SITE_CONFIG } from '@config/site';
import { PILLAR_NAVIGATION } from '@config/navigation';
import MobileMenu from './MobileMenu.astro';
---

<header class="sticky top-0 z-40 border-b border-line bg-paper/95 backdrop-blur">
  <div class="mx-auto flex h-14 max-w-6xl items-center justify-between px-4 md:h-16 md:px-6">
    <a href="/" aria-label={SITE_CONFIG.siteName} class="inline-flex min-h-11 items-center gap-3 rounded focus-visible:outline-2 focus-visible:outline-brand">
      <img src={SITE_CONFIG.logoPath} alt={SITE_CONFIG.siteName} width="160" height="40" class="h-9 w-auto md:h-10" loading="eager" />
      <span class="hidden text-sm font-bold tracking-wide text-ink md:inline">{SITE_CONFIG.siteName}</span>
    </a>
    <nav aria-label="主要ナビゲーション" class="hidden items-center gap-1 md:flex">
      {PILLAR_NAVIGATION.map((item) => (
        <a href={item.href} class="inline-flex min-h-11 items-center rounded px-3 text-sm font-bold text-ink-soft hover:text-brand focus-visible:outline-2 focus-visible:outline-brand">
          {item.label}
        </a>
      ))}
    </nav>
    <button id="mobile-menu-trigger" type="button" aria-expanded="false" aria-controls="mobile-menu-root" aria-label="メニューを開く" class="inline-flex min-h-11 min-w-11 items-center justify-center rounded text-brand focus-visible:outline-2 focus-visible:outline-brand md:hidden">
      <span aria-hidden="true" class="text-2xl leading-none">☰</span>
    </button>
  </div>
</header>
<MobileMenu navigation={[...PILLAR_NAVIGATION]} />
