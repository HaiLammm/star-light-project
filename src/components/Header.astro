---
import { SITE_CONFIG } from '@config/site';
---

<header class="sticky top-0 z-40 border-b border-line bg-paper/95 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 md:h-20 md:px-6">
    <a href="/" aria-label={SITE_CONFIG.siteName} class="inline-flex min-h-11 items-center gap-3 rounded focus-visible:outline-2 focus-visible:outline-brand">
      <img src={SITE_CONFIG.logoPath} alt={SITE_CONFIG.siteName} width="160" height="40" class="h-10 w-auto" loading="eager" />
      <span class="hidden text-sm font-bold tracking-wide text-ink md:inline">{SITE_CONFIG.siteName}</span>
    </a>
  </div>
</header>
