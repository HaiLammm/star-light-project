---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_CONFIG } from '@config/site';
---

<BaseLayout
  title="ウマノミカタ｜準備中"
  description={SITE_CONFIG.description}
  canonicalUrl={`${SITE_CONFIG.siteUrl}/`}
>
  <section class="mx-auto max-w-3xl px-4 py-24 text-center">
    <p class="text-sm font-bold uppercase tracking-[0.2em] text-brand">Umanomikata</p>
    <h1 class="mt-4 text-3xl font-black text-ink md:text-5xl">ウマノミカタの新しいトップページを準備中です</h1>
    <p class="mt-6 text-base leading-8 text-ink-soft">競馬をもっと深く、もっと楽しく。公開準備中です。</p>
  </section>
</BaseLayout>
