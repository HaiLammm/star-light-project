---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_CONFIG } from '@config/site';
---
<BaseLayout title={`編集方針｜${SITE_CONFIG.siteName}`} description={SITE_CONFIG.description} canonicalUrl={`${SITE_CONFIG.siteUrl}/editorial-policy/`}>
  <section class="mx-auto max-w-3xl px-4 py-16 md:px-6 md:py-24"><p class="text-sm font-bold uppercase tracking-[0.2em] text-brand">Editorial Policy</p><h1 class="mt-4 text-3xl font-black text-ink md:text-5xl">編集方針</h1><p class="mt-6 text-base leading-8 text-ink-soft">記事の制作・確認・更新に関する方針は、Epic 4で正式に掲載します。</p></section>
</BaseLayout>
