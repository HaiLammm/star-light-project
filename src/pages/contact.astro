---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ContactFormSection from '../components/ContactFormSection.astro';
import { SITE_CONFIG, REGIONAL_OFFICES } from '@config/site';
import { officeMapUrl } from '../utils/maps';

const breadcrumbItems = [
  { label: 'TOP', href: '/' },
  { label: '無料相談', href: '/contact/' },
];
---

<BaseLayout
  title="無料相談｜設備プロ"
  description="設備プロへの無料相談・お問い合わせフォームです。水漏れ・つまり・停電などのトラブルを24時間365日受付中。お見積りは無料、ご相談だけでもお気軽にご連絡ください。"
  canonicalUrl={`${SITE_CONFIG.siteUrl}/contact/`}
>
  <!-- Breadcrumb -->
  <div class="max-w-[1200px] mx-auto px-4 pt-4 pb-2">
    <Breadcrumb items={breadcrumbItems} />
  </div>

  <!-- KV (Key Visual) Banner -->
  <section class="bg-navy h-[160px] sm:h-[200px] md:h-[240px] relative flex items-center overflow-hidden">
    <div class="max-w-[1200px] mx-auto px-4 w-full relative">
      <h1 class="text-[24px] sm:text-[36px] md:text-[48px] font-black text-white ml-[16px] sm:ml-[30px] md:ml-[45px]">無料相談</h1>
    </div>
  </section>

  <!-- Contact Form Section -->
  <div class="py-[80px] md:py-[120px]">
    <ContactFormSection variant="page" />
  </div>

  <!-- Consultation Section -->
  <section class="pb-[80px] md:pb-[120px]">
    <div class="max-w-[1200px] mx-auto px-4">
      <div class="bg-white border border-border-warm rounded-[20px] md:rounded-[40px] px-[16px] sm:px-[24px] md:px-[42px] py-[30px] sm:py-[40px] md:py-[58px] relative overflow-hidden">
        <div class="relative z-[2]">
          <h2 class="text-[clamp(15px,5.2vw,32px)] font-black text-center text-navy">
            <span class="inline-block border-b-[4px] border-navy pb-[12px] whitespace-nowrap"><span class="text-cta">ご相談無料！</span>必ず事前にお見積り</span>
          </h2>
          <p class="mt-6 md:mt-8 text-[14px] md:text-[16px] text-[#333] leading-relaxed text-center max-w-[800px] mx-auto" style="overflow-wrap:anywhere;word-break:break-word;">
            作業費+材料費部品代+処分費(※)で作業料金を算出いたします。<br />
            それ以外にかかる見積り費や出張費、早朝・深夜料金、キャンセル料は一切いただきません。<br />
            作業前に必ずお見積りを提示しますので、まずは相談・見積もりご安心ください。
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Offices (NAP + link bản đồ; iframe chỉ đặt ở /company/office/ để trang form nhẹ) -->
  <section class="pb-[80px] md:pb-[120px]">
    <div class="max-w-[1200px] mx-auto px-4">
      <h2 class="text-[22px] md:text-[28px] font-black text-center text-navy mb-8 md:mb-10">営業所</h2>
      <ul class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6">
        {REGIONAL_OFFICES.map((office) => {
          const mapUrl = officeMapUrl(office);
          return (
            <li class="bg-white border border-[#e0e0e0] rounded-2xl p-5 md:p-6">
              <p class="text-[16px] md:text-[18px] font-bold text-[#333]">{office.name}</p>
              <p class="mt-2 text-[14px] md:text-[15px] text-[#555] leading-relaxed" style="overflow-wrap:anywhere;">{office.formattedAddress}</p>
              <p class="mt-1 text-[14px] md:text-[15px]">
                <a href={office.phone.href} class="text-water hover:underline">{office.phone.display}</a>
                <span class="text-[12px] text-[#999] ml-1">（{SITE_CONFIG.businessHours}）</span>
              </p>
              {mapUrl && (
                <a href={mapUrl} target="_blank" rel="noopener" class="mt-2 inline-flex items-center min-h-[44px] text-[14px] font-bold text-water hover:underline">
                  Googleマップで見る<span class="sr-only">（新しいタブで開きます）</span>
                </a>
              )}
            </li>
          );
        })}
      </ul>
      <p class="mt-6 text-center">
        <a href="/company/office/" class="inline-flex items-center min-h-[44px] text-[14px] md:text-[15px] font-bold text-water hover:underline">営業所一覧・対応エリアを見る</a>
      </p>
    </div>
  </section>

  <!-- FAQ link (merged from former nav item) -->
  <section class="pb-[80px] md:pb-[120px]">
    <div class="max-w-[1200px] mx-auto px-4 text-center">
      <p class="text-[15px] md:text-[17px] text-[#333]">
        お問い合わせの前に、よくいただくご質問もあわせてご確認ください。
      </p>
      <a
        href="/faq/"
        class="inline-flex items-center justify-center gap-[8px] mt-[20px] min-w-[240px] md:min-w-[280px] min-h-[56px] px-[24px] bg-water text-white text-[15px] md:text-[18px] font-bold rounded-[30px] hover:bg-water-deep transition-colors"
      >
        よくある質問を見る
      </a>
    </div>
  </section>
</BaseLayout>
