---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_CONFIG } from '@config/site';
---

<BaseLayout
  title="プライバシーポリシー｜ウマノミカタ"
  description={SITE_CONFIG.description}
  canonicalUrl={`${SITE_CONFIG.siteUrl}/privacy/`}
>
  <section class="mx-auto max-w-3xl px-4 py-24">
    <p class="text-sm font-bold uppercase tracking-[0.2em] text-brand">Privacy</p>
    <h1 class="mt-4 text-3xl font-black text-ink md:text-5xl">プライバシーポリシー</h1>
    <p class="mt-6 text-base leading-8 text-ink-soft">プライバシーに関する案内を準備中です。</p>
  </section>
</BaseLayout>
