---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_CONFIG } from '@config/site';
---

<BaseLayout
  title="ページが見つかりません｜ウマノミカタ"
  description={SITE_CONFIG.description}
  canonicalUrl={`${SITE_CONFIG.siteUrl}/404/`}
>
  <section class="mx-auto max-w-2xl px-4 py-24 text-center">
    <p class="text-sm font-bold uppercase tracking-[0.2em] text-brand">404</p>
    <h1 class="mt-4 text-3xl font-black text-ink md:text-5xl">ページが見つかりません</h1>
    <p class="mt-6 text-base leading-8 text-ink-soft">
      お探しのページは移動または削除された可能性があります。トップページからお進みください。
    </p>
    <div class="mt-10">
      <a href="/" class="inline-flex min-h-11 items-center justify-center rounded-full bg-brand px-6 py-3 font-bold text-white">
        トップページへ戻る
      </a>
    </div>
  </section>
</BaseLayout>
